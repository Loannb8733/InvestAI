# Dockerfile optimisé pour Render Free Tier (512MB RAM)
# - Pas de CmdStan/Prophet (trop lourd)
# - Multi-stage build pour réduire la taille de l'image
# - Dépendances système minimales

FROM python:3.12-slim AS builder

WORKDIR /build

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    libpq-dev \
    libffi-dev \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir --prefix=/install -r requirements.txt

# --- Runtime stage ---
FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /install /usr/local


RUN adduser --disabled-password --gecos '' appuser
COPY --chown=appuser . .
USER appuser

EXPOSE 8000

# Render injects $PORT at runtime.
# Run DB migrations on boot (web service only — worker/beat override this CMD via
# their startCommand in render.yaml, so migrations run exactly once per deploy).
# Fail-open: if the migration errors (e.g. prod schema drift), log it and still
# start the app rather than taking the whole service down on an auto-deploy.
CMD alembic upgrade head || echo "ALEMBIC MIGRATION FAILED"; uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000}
