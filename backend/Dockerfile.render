# Image de production de l'API, du worker et du planificateur Celery.
# - Render gratuit (512 Mo) : sans Prophet (WITH_PROPHET=false, par défaut).
# - VM Oracle (deploy/oracle) : avec Prophet (WITH_PROPHET=true) ; mesuré +30 Mo au pic d'une prévision.
# - Multi-stage build pour réduire la taille de l'image
# - Dépendances système minimales

FROM python:3.12-slim AS builder

ARG WITH_PROPHET=false

WORKDIR /build

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    libpq-dev \
    libffi-dev \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt requirements-prophet.txt ./
RUN if [ "$WITH_PROPHET" = "true" ]; then EXTRA="-r requirements-prophet.txt"; else EXTRA=""; fi \
    && pip install --no-cache-dir --prefix=/install -r requirements.txt $EXTRA

# --- Runtime stage ---
FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /install /usr/local


RUN adduser --disabled-password --gecos '' appuser \
    && mkdir -p /beat && chown appuser /beat
COPY --chown=appuser . .
USER appuser

EXPOSE 8000

# Render injects $PORT at runtime.
# Run DB migrations on boot, once per deploy: the web service is the only service.
# Fail-open: if the migration errors (e.g. prod schema drift), log it and still
# start the app rather than taking the whole service down on an auto-deploy.
CMD alembic upgrade head || echo "ALEMBIC MIGRATION FAILED"; uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000}
